# --- LLM provider (section 8 of CLAUDE.md) ---
LLM_PROVIDER=gemini          # gemini | claude
GEMINI_API_KEY=              # from Google AI Studio
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=           # leave empty until funded; flip LLM_PROVIDER=claude when set
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Storage ---
DATABASE_URL=sqlite:///data/app.db

# --- GitHub (profile builder ingestion) ---
# Fine-grained token, Repository access: All repositories, permissions:
# Metadata (read) + Contents (read). Identity comes from the token itself
# (GET /user), so no username field is needed.
GITHUB_TOKEN=

# --- Gmail send (google-api-python-client OAuth2) ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_SENDER_ADDRESS=

# --- Outreach cadence ---
# Days without a reply before an application shows up on the dashboard as
# overdue (follow up / escalate / mark NO_RESPONSE - always your call).
NO_RESPONSE_DAYS=14
# Minimum seconds between two outgoing sends (deliverability, section 9).
SEND_DELAY_SECONDS=60

# --- LinkedIn company research (optional, off by default) ---
# Browser automation against LinkedIn violates their ToS and can get the
# account restricted - use a DEDICATED THROWAWAY ACCOUNT, never your real one.
# One-time setup (see README "LinkedIn research"):
#   1. install uv (https://docs.astral.sh/uv/)
#   2. uvx mcp-server-linkedin@latest --login   (log in with the throwaway
#      account; the session persists under ~/.linkedin-mcp/ - re-run on expiry)
#   3. set LINKEDIN_RESEARCH_ENABLED=true
# The package is mcp-server-linkedin. "linkedin-mcp-server" on PyPI is an
# unrelated project by someone else - don't swap the words around. Keep
# @latest: LinkedIn changes its pages often and a pinned version goes stale.
LINKEDIN_RESEARCH_ENABLED=false
LINKEDIN_MCP_COMMAND=uvx mcp-server-linkedin@latest
# Searched in the company's people tab to find people worth contacting.
# One extra page load per term - shorten the list to make research faster,
# leave it empty to skip the targeted search entirely.
LINKEDIN_PEOPLE_KEYWORDS=CEO,CTO,müdür,insan kaynakları,HR,founder
LINKEDIN_MCP_TIMEOUT_SECONDS=900
LINKEDIN_TOOL_DELAY_SECONDS=3.0

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
