# --- LLM provider (section 8 of CLAUDE.md) ---
LLM_PROVIDER=gemini          # gemini | claude
GEMINI_API_KEY=              # from Google AI Studio
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=           # leave empty until funded; flip LLM_PROVIDER=claude when set
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Storage ---
DATABASE_URL=sqlite:///data/app.db

# --- GitHub (profile builder ingestion) ---
# Fine-grained token, Repository access: All repositories, permissions:
# Metadata (read) + Contents (read). Identity comes from the token itself
# (GET /user), so no username field is needed.
GITHUB_TOKEN=

# --- Gmail send (google-api-python-client OAuth2) ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_SENDER_ADDRESS=

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
